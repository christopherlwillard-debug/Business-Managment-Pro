    "verify:production-reviews": "tsx ./scripts/e2e-mfh-production-reviews-verify.ts",
    "verify:component-baseline-reviews": "tsx ./scripts/e2e-mfh-component-baseline-reviews-verify.ts",
    "verify:job-production-components": "tsx ./scripts/e2e-job-production-components-verify.ts",
