    "openai": "^6.32.0",
    "openid-client": "^6.8.2",
    "@napi-rs/canvas": "^0.1.80",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "pdfkit": "^0.19.1",
    "plaid": "^42.2.0",
    "puppeteer": "^24.42.0",
    "qrcode": "^1.5.4",
